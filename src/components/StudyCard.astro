---
import CodeIcon from "./Icons/CodeIcon.astro";

const {
  institution,
  career,
  start,
  end,
  status,
} = Astro.props;
---

<div class="study-card">
  <div class="study-header">
    <div>
      <h3>{institution}</h3>

      <p class="career">
        {career}
      </p>
    </div>

    <span class={`status ${status === "En curso" ? "active" : ""}`}>
      {status}
    </span>
  </div>

  <div class="timeline">
    <span>{start}</span>

    <div class="timeline-center">
      <div class="line"></div>

      <CodeIcon class="icon" />

      <div class="line"></div>
    </div>

    <span>{end}</span>
  </div>
</div>

<style>
  .study-card {
    padding: 24px;
    border-radius: 18px;

    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);

    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;

    margin-bottom: 24px;
  }

  .study-card:hover {
    transform: translateY(-3px);

    background: rgba(255,255,255,0.06);

    box-shadow:
      0 0 24px rgba(34, 211, 238, 0.08);
  }

  .study-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;

    margin-bottom: 22px;
  }

  .study-header h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: white;
  }

  .career {
    margin-top: 6px;
    opacity: 0.75;
    font-size: 1rem;
  }

  .status {
    padding: 6px 12px;
    border-radius: 999px;

    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);

    font-size: 0.85rem;
    white-space: nowrap;
  }

  .status.active {
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.2);

    color: #22d3ee;
  }

  .timeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;

    opacity: 0.8;
    font-size: 0.95rem;
  }

  .timeline-center {
    display: flex;
    align-items: center;
    gap: 10px;

    flex: 1;
  }

  .line {
    flex: 1;
    height: 1px;

    background:
      rgba(255,255,255,0.15);
  }

  .icon {
    width: 20px;
    height: 20px;

    color: #22d3ee;

    filter:
      drop-shadow(0 0 8px rgba(34,211,238,0.4));
  }

  @media (max-width: 640px) {
    .study-header {
      flex-direction: column;
    }

    .timeline {
      flex-direction: column;
      align-items: flex-start;
    }

    .timeline-center {
      width: 100%;
    }
  }
</style>