---
const skills = {
  Frontend: [
    { name: "HTML", level: 90, icon: "🌐" },
    { name: "CSS", level: 85, icon: "🎨" },
    { name: "JavaScript", level: 90, icon: "🟨" },
    { name: "React", level: 80, icon: "⚛️" },
  ],
  Backend: [
    { name: "Node.js", level: 60, icon: "🟢" },
  ],
  Tools: [
    { name: "Astro", level: 75, icon: "🚀" },
    { name: "Git / GitHub", level: 75, icon: "🐙" },
  ],
};
---

<section class="skills-section" id="skills">
  <h2>Skills</h2>

  <div class="skills-container">
    {Object.entries(skills).map(([category, items]) => (
      <div class="category">
        <h3 class="category-title">{category}</h3>

        {items.map((skill) => (
          <div class="skill">
            <div class="skill-info">
                <span class="skill-name">
                <span class="icon">{skill.icon}</span>
                {skill.name}
                </span>
                <span>{skill.level}%</span>
            </div>

            <div class="bar">
                <div
                class="progress"
                style="width: 0%"
                data-width={`${skill.level}%`}
                />
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  const bars = document.querySelectorAll(".progress");

  const animateBar = (el) => {
    const target = el.getAttribute("data-width");
    const value = parseInt(target);

    let current = 0;

    const interval = setInterval(() => {
      if (current >= value) {
        clearInterval(interval);
        return;
      }

      current += 1;
      el.style.width = current + "%";
    }, 12); // velocidad de “subida”
  };

  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        animateBar(entry.target);
        obs.unobserve(entry.target);
      });
    },
    { threshold: 0.3 }
  );

  bars.forEach((bar) => observer.observe(bar));
</script>

<style>
  .skills-section {
    padding: 90px 20px;
    color: white;
  }

  .skills-section h2 {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 50px;
    letter-spacing: 1px;
  }

  .skills-container {
    max-width: 750px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .category {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .category-title {
    font-size: 1.2rem;
    margin-bottom: 10px;
    opacity: 0.9;
    border-left: 3px solid #22d3ee;
    padding-left: 10px;
  }

  .skill {
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .skill:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.08);
  }

  .skill-info {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .skill-info span:last-child {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .skill-name {
  display: flex;
  align-items: center;
  gap: 8px;
  }
  
  .icon {
    font-size: 16px;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.2));
    transition: transform 0.2s ease;
  }

  .skill:hover .icon {
    transform: scale(1.1);
  }

  .bar {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #7c3aed, #22d3ee, #7c3aed);
    background-size: 200% 100%;
    animation: shimmer 2s infinite linear;
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.25);
    width: 0%;
    transition: width 0.2s linear;
  }

  @keyframes shimmer {
    0% {
        background-position: 0% 50%;
    }
    100% {
        background-position: 200% 50%;
    }
  }
</style>